# Copy to .env.local and fill in. Never commit .env.local.
# Names only — no values. What each variable needs is described above it.
# Public (NEXT_PUBLIC_*) values reach the browser; everything else is server-only.

# Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
# Safe in the browser only because every public table has RLS with no policies.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used to broadcast realtime events and sign storage URLs.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase → Connect → ORMs. Pooled (Supavisor, port 6543) — used by the app.
DATABASE_URL=
# Direct connection (port 5432) — used by prisma migrate only.
DIRECT_URL=

# Mapbox → Access tokens. A public "pk." token restricted to this app's URLs.
NEXT_PUBLIC_MAPBOX_TOKEN=
# A separate token used only on the server for Directions and Search.
MAPBOX_SECRET_TOKEN=

# Razorpay → Settings → API Keys, in TEST mode only.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay → Webhooks, the secret you set when creating the webhook.
RAZORPAY_WEBHOOK_SECRET=

# Public base URL of this deployment (the local dev server's address in development).
NEXT_PUBLIC_APP_URL=

# Random 32+ bytes. Vercel Cron sends it as a bearer token to /api/cron/daily.
# Generate with: openssl rand -base64 32
CRON_SECRET=

# Random 32+ bytes, mixed into share-link token hashes.
SHARE_TOKEN_PEPPER=

# Comma-separated emails allowed into /ops. Deliberately not a database flag.
OPS_ADMIN_EMAILS=

# Tests only: 1 replaces Mapbox and Razorpay with deterministic fakes. Never set in production.
COMET_FAKE_EXTERNALS=

# Which environment this deployment represents: dev | qa | stage | prod.
# Anything unrecognised reads as dev (shows the "Dev" badge).
APP_ENV=
